# Agent governance template for directory-backend
# No secrets in this file.

# Core policy
AGENTS_ENABLED=true
AGENTS_CONFIG_PATH=.github/agents
AGENTS_POLICY_MODE=ENFORCE
AGENTS_POLICY_VERSION=1

# Global rules
AGENT_GLOBAL_REQUIRE_BACKWARD_COMPAT_API_V1=true
AGENT_GLOBAL_REQUIRE_SERVICE_LAYER_RESPONSEENTITY=true
AGENT_GLOBAL_REQUIRE_DIRECTORY_CONSTANTS_USAGE=true
AGENT_GLOBAL_REQUIRE_MESSAGE_HEADER_SEMANTICS=true
AGENT_GLOBAL_REQUIRE_MINIMAL_ATOMIC_CHANGES=true
AGENT_GLOBAL_REQUIRE_TESTS_FOR_RUNNABLE_CODE=true
AGENT_GLOBAL_REQUIRE_NO_UNRELATED_REFACTOR=true

# API contract synchronization
AGENT_GLOBAL_REQUIRE_API_SYNC=true
AGENT_GLOBAL_API_ANNOTATIONS_PATH_PATTERN=src/main/java/**/api/v1/controller/*Api.java
AGENT_GLOBAL_API_SPEC_PATH=src/main/resources/api/index.yaml
AGENT_GLOBAL_BLOCK_CONTRACT_CHANGE_WITHOUT_SYNC=true

# Sensitive assets and secrets restrictions
AGENT_GLOBAL_BLOCK_SECRET_CONTENT=true
AGENT_GLOBAL_BLOCK_SECRET_COMMITS=true
AGENT_GLOBAL_BLOCK_ENV_SECRET_PLACEHOLDERS=true
AGENT_GLOBAL_PROTECTED_FILES=default.env,src/main/resources/*.crt,src/main/resources/keystore.jks,certs-file/*.crt,certs-file/keystore.jks
AGENT_GLOBAL_DENY_EDIT_PROTECTED_FILES=true

# Allowed edit surface (default)
AGENT_GLOBAL_ALLOWED_PATHS=src/main/java,src/test/java,src/main/resources/api,docs,.github/agents

# Developer
AGENT_DEVELOPER_ENABLED=true
AGENT_DEVELOPER_CAN_EDIT_SRC_MAIN=true
AGENT_DEVELOPER_CAN_EDIT_SRC_TEST=true
AGENT_DEVELOPER_CAN_EDIT_API_SPEC=true
AGENT_DEVELOPER_MUST_PRESERVE_API_V1_BEHAVIOR=true
AGENT_DEVELOPER_MUST_USE_EXISTING_CONSTANTS=true
AGENT_DEVELOPER_MUST_NOT_EDIT_CERTS_OR_KEYSTORE=true
AGENT_DEVELOPER_MUST_NOT_ADD_SECRETS=true

# QA / Test Writer
AGENT_QA_TEST_WRITER_ENABLED=true
AGENT_QA_TEST_WRITER_CAN_CREATE_OR_EDIT_TESTS=true
AGENT_QA_TEST_WRITER_CAN_ADD_TEST_FIXTURES=true
AGENT_QA_TEST_WRITER_CANNOT_CHANGE_PUBLIC_API_CONTRACT=true
AGENT_QA_TEST_WRITER_CANNOT_EDIT_PRODUCTION_CERT_OR_KEYSTORE=true
AGENT_QA_TEST_WRITER_CANNOT_ADD_SECRETS=true

# Product Owner
AGENT_PRODUCT_OWNER_ENABLED=true
AGENT_PRODUCT_OWNER_CAN_EDIT_ACCEPTANCE_CRITERIA=true
AGENT_PRODUCT_OWNER_CAN_EDIT_API_DOCUMENTATION=true
AGENT_PRODUCT_OWNER_CANNOT_EDIT_RUNTIME_SECURITY_ASSETS=true
AGENT_PRODUCT_OWNER_CANNOT_ADD_SECRETS=true

# Project Manager
AGENT_PROJECT_MANAGER_ENABLED=true
AGENT_PROJECT_MANAGER_CAN_EDIT_RELEASE_DOCS=true
AGENT_PROJECT_MANAGER_CAN_EDIT_CI_CHECKLISTS=true
AGENT_PROJECT_MANAGER_CANNOT_EDIT_PRODUCTION_CODE=true
AGENT_PROJECT_MANAGER_CANNOT_ADD_SECRETS=true

# API Reviewer
AGENT_API_REVIEWER_ENABLED=true
AGENT_API_REVIEWER_CAN_VALIDATE_API_CONTRACTS=true
AGENT_API_REVIEWER_CANNOT_EDIT_RUNTIME_SECURITY_ASSETS=true
AGENT_API_REVIEWER_CANNOT_ADD_SECRETS=true

# Code Reviewer
AGENT_CODE_REVIEWER_ENABLED=true
AGENT_CODE_REVIEWER_CAN_RUN_STATIC_VALIDATIONS=true
AGENT_CODE_REVIEWER_CANNOT_EDIT_RUNTIME_SECURITY_ASSETS=true
AGENT_CODE_REVIEWER_CANNOT_ADD_SECRETS=true

# Database Architect
AGENT_DATABASE_ARCHITECT_ENABLED=true
AGENT_DATABASE_ARCHITECT_CAN_EDIT_JPA_AND_MIGRATIONS=true
AGENT_DATABASE_ARCHITECT_MUST_KEEP_H2_COMPAT=true
AGENT_DATABASE_ARCHITECT_CANNOT_ADD_SECRETS=true

# DevOps Engineer
AGENT_DEVOPS_ENGINEER_ENABLED=true
AGENT_DEVOPS_ENGINEER_CAN_EDIT_WORKFLOWS_AND_DOCKER=true
AGENT_DEVOPS_ENGINEER_CANNOT_EDIT_CERTS_OR_KEYSTORE=true
AGENT_DEVOPS_ENGINEER_CANNOT_ADD_SECRETS=true

# Security Reviewer
AGENT_SECURITY_REVIEWER_ENABLED=true
AGENT_SECURITY_REVIEWER_CAN_RUN_CVE_AUDITS=true
AGENT_SECURITY_REVIEWER_CAN_RECOMMEND_REMEDIATION=true
AGENT_SECURITY_REVIEWER_CANNOT_ADD_SECRETS=true

# Repo Requirements Analyst
AGENT_REPO_REQUIREMENTS_ANALYST_ENABLED=true
AGENT_REPO_REQUIREMENTS_ANALYST_CAN_EDIT_REQUIREMENTS_DOCS=true
AGENT_REPO_REQUIREMENTS_ANALYST_CAN_PROPOSE_INCREMENTAL_CHANGES=true
AGENT_REPO_REQUIREMENTS_ANALYST_CANNOT_EDIT_CERTS_OR_KEYSTORE=true
AGENT_REPO_REQUIREMENTS_ANALYST_CANNOT_ADD_SECRETS=true

# Policy gates
AGENT_GATE_BLOCK_ON_POLICY_VIOLATION=true
AGENT_GATE_WARN_ON_UNSYNCED_API_FILES=true
AGENT_GATE_REQUIRE_TEST_SIGNAL_ON_CODE_CHANGE=true

